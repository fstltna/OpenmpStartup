my $OPENMPDIR = "/opt/omp-server/Server/";
my $SCREENCMD = "/usr/bin/screen";

# No changes below here...

my $startpath = $ENV{'PATH'};
my $newpath = "$OPENMPDIR/exec:$startpath";
my $exists = "";

# Set ENV vars
$ENV{'PATH'} = $newpath;
$ENV{'TERM'} = "xterm-256color";

#my $running=`ps ax|grep startomp|grep -v grep`;

# check if Open.mp process is running
#if ($running ne "")
#{
#	print ("Startupscript already running...\n");
#	exit (0);
#}

while (-1)
{
	chdir $OPENMPDIR;
	# check if Open.mp is running
	$running=`ps ax|grep omp-server|grep -v grep`;
	if ($running eq "")
	{
		print "Open.mp not running\n";
		# See if they want the server started
		if (! -f "$OPENMPDIR/nostart")
		{
			# The Log Entry
			my $datestring = localtime();
			my $TIME="Open.mp Down, Restarting: $datestring";
			open(OUTF, ">>$OPENMPDIR/OpenmpScreen.log") || die "Unable to open $OPENMPDIR/OpenmpScreen.log for appending";
			print (OUTF "$TIME\n");
			close($OUTF);
			chdir $OPENMPDIR;
			my $OMPLog = "$OPENMPDIR/Openmp.log";
                        if (-f $OMPLog)
                        {
                                system("mv $OMPLog $OMPLog-previous");
                        }
			print "Starting screen process\n";
			system("$SCREENCMD -fa -S Openmp -d -U -m ./omp-server");
		}
	}
	# Sleep for 1 minute before checking again
	sleep(60);
}
exit(0);
